# DevHub 环境变量配置
# 复制此文件为 .env.local 并填入实际值

# ========================
# Clerk（用户认证）
# ========================
# 从 https://dashboard.clerk.com 获取
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# ========================
# Supabase（数据库）
# ========================
# 从 https://supabase.com/dashboard 获取（Project Settings > API）
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ========================
# 服务端环境变量（Vercel Dashboard 配置）
# ========================
# 以下变量在 Vercel Dashboard > Settings > Environment Variables 中配置
# 不要在 .env.local 中填写，这些是 Serverless Functions 使用的
#
# CLERK_SECRET_KEY=sk_test_xxx
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=sk-...
